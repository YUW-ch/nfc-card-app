# Base URL of the Taplino backend API (NestJS). No trailing slash.
NEXT_PUBLIC_API_URL=http://localhost:3311

# Public base URL of THIS app (used to build share links + card QR targets).
NEXT_PUBLIC_APP_URL=http://localhost:3310

# Dev only: override the login prefill (ignored outside `next dev`).
# Defaults to the backend's dev user (pnpm db:seed:dev): dev@taplino.ch / taplino-dev.
# NEXT_PUBLIC_DEV_LOGIN_EMAIL=you@business.ch
# NEXT_PUBLIC_DEV_LOGIN_PASSWORD=
